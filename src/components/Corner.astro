---
import SectionHeader from './ui/SectionHeader.astro'
import Tag from './ui/Tag.astro'
import { corner } from '../data/content'
---

<section id="rincon" class="relative z-10 border-t border-[var(--color-line)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <SectionHeader kicker="Mi rincón · El equipo del campeón" class="mb-14">
      Nadie pelea solo:<br /><span class="text-fire">esta es mi esquina</span>
      <span slot="subtitle">
        Ningún programador gana un main event sin su equipo. Estas son las herramientas que tengo
        en la esquina, agrupadas por lo que resuelven — no por moda.
      </span>
    </SectionHeader>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        corner.map((c) => (
          <div data-reveal class="card p-6">
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-lg border border-[var(--color-line)] bg-[var(--color-void)]">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  class="text-[var(--color-belt-gold)]"
                  aria-hidden="true"
                >
                  <path d={c.icon} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <h3 class="font-cond text-lg font-semibold uppercase tracking-wide text-[var(--color-bone)]">{c.role}</h3>
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              {c.team.map((t) => <Tag>{t}</Tag>)}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
