---
import SectionHeader from './ui/SectionHeader.astro'
import Tag from './ui/Tag.astro'
import ProjectCard from './ui/ProjectCard.astro'
import { mainEvent, coMain, undercard } from '../data/projects'
---

<section id="cartelera" class="relative z-10 border-t border-[var(--color-line)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <SectionHeader kicker="La cartelera · Proyectos confirmados" class="mb-14">
      Cada proyecto,<br /><span class="text-gold">una pelea ganada</span>
      <span slot="subtitle">
        No colecciono tutoriales. Cada cartel de abajo es trabajo real: desde un cliente que paga
        hasta un compilador que traduce C a Forth. Elige el combate que quieras ver.
      </span>
    </SectionHeader>

    <!-- MAIN EVENT -->
    <article data-reveal class="card mb-6 grid overflow-hidden p-0 lg:grid-cols-2">
      <div class="relative min-h-[16rem] overflow-hidden border-b border-[var(--color-line)] lg:border-b-0 lg:border-r">
        <img
          src={mainEvent.img}
          alt={mainEvent.title}
          class="h-full w-full object-cover"
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <span class="absolute left-4 top-4 rounded-full bg-[var(--color-ring-red)] px-3 py-1 font-mono text-[10px] tracking-[0.2em] text-white">
          MAIN EVENT
        </span>
      </div>
      <div class="flex flex-col justify-center p-7 sm:p-10">
        <p class="font-mono text-xs tracking-[0.25em] text-[var(--color-belt-gold)]">{mainEvent.tag}</p>
        <h3 class="mt-3 font-head text-3xl text-[var(--color-bone)] sm:text-4xl">{mainEvent.title}</h3>
        <p class="mt-4 text-sm leading-relaxed text-[var(--color-muted)] sm:text-base">{mainEvent.desc}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {mainEvent.tags.map((t) => <Tag>{t}</Tag>)}
        </div>
        <a
          href={mainEvent.link}
          {...mainEvent.external ? { target: '_blank', rel: 'noreferrer' } : {}}
          class="mt-8 inline-flex items-center gap-2 font-cond text-sm font-semibold uppercase tracking-wide text-[var(--color-belt-gold)] transition-colors hover:text-[var(--color-bone)]"
        >
          {mainEvent.cta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>

    <!-- CO-MAIN -->
    <div class="mb-6 grid gap-5 lg:grid-cols-2">
      {
        coMain.map((p) => (
          <article data-reveal class="card flex flex-col overflow-hidden p-0 sm:flex-row">
            <div class="relative w-full overflow-hidden border-b border-[var(--color-line)] sm:w-2/5 sm:border-b-0 sm:border-r">
              <img
                src={p.img}
                alt={p.title}
                class="h-full w-full object-cover"
                width="400"
                height="400"
                loading="lazy"
                decoding="async"
              />
              <span class="absolute left-3 top-3 rounded-full bg-[var(--color-ring-blue)] px-2.5 py-1 font-mono text-[9px] tracking-[0.2em] text-white">
                SEMIFINAL
              </span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="font-mono text-[11px] tracking-[0.25em] text-[var(--color-belt-gold)]">{p.tag}</p>
              <h3 class="mt-2 font-head text-xl text-[var(--color-bone)]">{p.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">{p.desc}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {p.tags.map((t) => <Tag size="sm" variant="plain">{t}</Tag>)}
              </div>
              <a
                href={p.link}
                target="_blank"
                rel="noreferrer"
                class="mt-4 inline-flex items-center gap-2 font-cond text-xs font-semibold uppercase tracking-wide text-[var(--color-muted)] transition-colors hover:text-[var(--color-bone)]"
              >
                {p.cta} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- UNDERCARD -->
    <p
      data-reveal
      class="mb-5 mt-12 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.3em] text-[var(--color-faint)]"
    >
      Undercard · Resto del cartel <span class="rule-belt flex-1 opacity-30"></span>
    </p>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {undercard.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</section>
