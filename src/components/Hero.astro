---
import Ticker from './Ticker.astro'
import { heroTicker, pitchHtml } from '../data/site'

// Fecha objetivo de la cuenta atrás (editable): próximo gran cartel
const EVENT_DATE = '2027-07-24T22:00:00+02:00'

const tale = [
  { label: 'Experiencia real', me: 'Cliente real en producción', rival: 'Ejercicios de bootcamp' },
  { label: 'Alcance', me: 'Front · Back · Infra · Seguridad', rival: 'Solo la parte bonita' },
  { label: 'Bajo presión', me: 'Árbitro federado', rival: 'Nunca ha roto producción' },
  { label: 'Tráfico', me: 'Diseñado para el pico', rival: 'Cae con 100 usuarios' },
  { label: 'Motivo', me: 'Ganar por KO', rival: 'Participar' },
]
---

<section id="cartel" class="relative z-10 overflow-hidden pt-28 pb-10 sm:pt-32">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-8 lg:px-10">
    <!-- Columna izquierda: el anuncio -->
    <div class="text-center lg:text-left">
      <p data-reveal class="kicker mb-5">Ibai · La Velada del Año — Candidatura oficial 2027</p>

      <h1 data-reveal class="headline text-[13vw] sm:text-[9rem] lg:text-[7.4rem]">
        <span class="block text-chrome">El programador</span>
        <span class="relative block">
          <span class="text-gold animate-shine bg-[length:200%_auto]">que aguanta</span>
        </span>
        <span class="block text-fire">el main event</span>
      </h1>

      <p data-reveal class="mx-auto mt-7 max-w-xl text-base leading-relaxed text-[var(--color-muted)] sm:text-lg lg:mx-0">
        <Fragment set:html={pitchHtml} />
      </p>

      <div data-reveal class="mt-9 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
        <a href="#contrato" class="btn btn-primary">
          Contrátame para el cartel
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="#reto" class="btn btn-ghost">Ver los asaltos</a>
      </div>

      <!-- Cuenta atrás -->
      <div
        data-reveal
        class="mt-10 inline-flex flex-wrap items-center gap-4 rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink)]/70 px-5 py-4 backdrop-blur"
      >
        <div class="flex items-center gap-2">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-ring-red)] opacity-75"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[var(--color-ring-red)]"></span>
          </span>
          <span class="font-mono text-[11px] uppercase tracking-[0.25em] text-[var(--color-muted)]">Cuenta atrás</span>
        </div>
        <div id="countdown" data-target={EVENT_DATE} class="flex items-center gap-3 font-head text-2xl text-[var(--color-bone)] sm:text-3xl">
          <span data-cd="days">--</span><span class="font-mono text-xs text-[var(--color-faint)]">D</span>
          <span data-cd="hours">--</span><span class="font-mono text-xs text-[var(--color-faint)]">H</span>
          <span data-cd="mins">--</span><span class="font-mono text-xs text-[var(--color-faint)]">M</span>
          <span data-cd="secs">--</span><span class="font-mono text-xs text-[var(--color-faint)]">S</span>
        </div>
      </div>
    </div>

    <!-- Columna derecha: el cartel / tale of the tape -->
    <div data-reveal class="relative mx-auto w-full max-w-sm">
      <div
        class="pointer-events-none absolute -inset-6 rounded-[2rem] bg-[conic-gradient(from_0deg,rgba(255,45,63,0.35),transparent_30%,rgba(47,107,255,0.35),transparent_60%,rgba(246,195,67,0.4),transparent)] opacity-60 blur-2xl"
        aria-hidden="true"
      ></div>

      <div class="scanlines relative overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-panel)]">
        <div class="flex items-center justify-between border-b border-[var(--color-line)] px-5 py-3">
          <span class="font-mono text-[10px] tracking-[0.25em] text-[var(--color-muted)]">CARTEL · MAIN EVENT</span>
          <span class="font-mono text-[10px] tracking-[0.25em] text-[var(--color-belt-gold)]">#00001</span>
        </div>

        <div class="flex items-stretch gap-3 px-5 pt-6">
          <!-- Esquina roja -->
          <div class="flex flex-1 flex-col items-center text-center">
            <div class="h-24 w-24 overflow-hidden rounded-full border-2 border-[var(--color-ring-red)]/70 shadow-[0_0_40px_-8px_rgba(255,45,63,0.7)]">
              <img
                src="/images/1726564320490.jpeg"
                alt="Jorge Condado Carballo"
                class="h-full w-full object-cover"
                width="96"
                height="96"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <p class="mt-3 font-head text-lg leading-none text-[var(--color-ring-red)]">JORGE<br />CONDADO</p>
            <p class="mt-1 font-mono text-[10px] tracking-widest text-[var(--color-muted)]">ESQUINA ROJA</p>
          </div>

          <div class="flex flex-col items-center justify-center">
            <span class="font-head text-4xl text-[var(--color-bone)]">VS</span>
          </div>

          <!-- Esquina azul -->
          <div class="flex flex-1 flex-col items-center text-center">
            <div class="flex h-24 w-24 items-center justify-center rounded-full border-2 border-[var(--color-ring-blue)]/60 bg-[var(--color-void)] font-head text-3xl text-[var(--color-ring-blue)] animate-float">
              30K
            </div>
            <p class="mt-3 font-head text-lg leading-none text-[var(--color-ring-blue)]">LA<br />COMPETENCIA</p>
            <p class="mt-1 font-mono text-[10px] tracking-widest text-[var(--color-muted)]">ESQUINA AZUL</p>
          </div>
        </div>

        <div class="mt-6 divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
          {
            tale.map((row) => (
              <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 px-5 py-2.5">
                <span class="text-right text-sm font-semibold text-[var(--color-bone)]">{row.me}</span>
                <span class="px-2 font-mono text-[10px] uppercase tracking-widest text-[var(--color-faint)]">{row.label}</span>
                <span class="text-left text-sm text-[var(--color-muted)] line-through decoration-[var(--color-ring-red)]/50">
                  {row.rival}
                </span>
              </div>
            ))
          }
        </div>

        <div class="border-t border-[var(--color-line)] bg-[var(--color-void)]/60 px-5 py-4 text-center">
          <p class="font-cond text-sm uppercase tracking-[0.2em] text-[var(--color-belt-gold)]">
            El cinturón: el puesto oficial
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-14">
    <Ticker items={heroTicker} tone="gold" />
  </div>
</section>

<script>
  const el = document.getElementById('countdown')
  if (el) {
    const targetTime = new Date(el.getAttribute('data-target') || '2027-07-24T22:00:00+02:00').getTime()
    const fields = {
      days: el.querySelector('[data-cd="days"]') as HTMLElement | null,
      hours: el.querySelector('[data-cd="hours"]') as HTMLElement | null,
      mins: el.querySelector('[data-cd="mins"]') as HTMLElement | null,
      secs: el.querySelector('[data-cd="secs"]') as HTMLElement | null,
    }
    const pad = (n: number) => String(n).padStart(2, '0')
    const tick = () => {
      const diff = Math.max(0, targetTime - Date.now())
      const d = Math.floor(diff / 86400000)
      const h = Math.floor((diff % 86400000) / 3600000)
      const m = Math.floor((diff % 3600000) / 60000)
      const s = Math.floor((diff % 60000) / 1000)
      if (fields.days) fields.days.textContent = String(d)
      if (fields.hours) fields.hours.textContent = pad(h)
      if (fields.mins) fields.mins.textContent = pad(m)
      if (fields.secs) fields.secs.textContent = pad(s)
    }
    tick()
    setInterval(tick, 1000)
  }
</script>
