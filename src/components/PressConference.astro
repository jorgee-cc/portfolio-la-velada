---
import SectionHeader from './ui/SectionHeader.astro'
import { press, outlets } from '../data/content'
---

<section id="rueda" class="relative z-10 border-t border-[var(--color-line)] py-20 sm:py-28">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-64 bg-[radial-gradient(60%_100%_at_50%_0%,rgba(246,195,67,0.12),transparent_70%)]" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <SectionHeader kicker="Rueda de prensa · Sala acreditada" class="mb-10">
      El careo final:<br /><span class="text-gold">la prensa pregunta</span>
      <span slot="subtitle">
        Antes de firmar un cartel, hay que responder. Sin guion y sin filtros: las dudas que
        cualquier organización tendría antes de poner su evento en mis manos.
      </span>
    </SectionHeader>

    <!-- Muro de medios acreditados -->
    <div data-reveal class="mb-8 flex flex-wrap items-center gap-2 border-y border-[var(--color-line)] py-4">
      <span class="mr-2 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.25em] text-[var(--color-faint)]">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-ring-red)] opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-ring-red)]"></span>
        </span>
        Medios acreditados
      </span>
      {
        outlets.map((o) => (
          <span class="rounded-full border border-[var(--color-line)] bg-[var(--color-void)] px-3 py-1 font-cond text-xs uppercase tracking-wide text-[var(--color-muted)]">
            {o}
          </span>
        ))
      }
    </div>

    <!-- Transcripción de la rueda de prensa -->
    <div class="grid gap-4 lg:grid-cols-2">
      {
        press.map((item, i) => (
          <details data-reveal open={i === 0} class="card group p-0 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-start gap-4 p-6">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[var(--color-line)] bg-[var(--color-void)] text-[var(--color-belt-gold)]">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <rect x="9" y="3" width="6" height="11" rx="3" />
                  <path d="M6 11a6 6 0 0012 0M12 17v4M9 21h6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="flex-1">
                <span class="block font-mono text-[10px] uppercase tracking-[0.25em] text-[var(--color-faint)]">
                  {item.outlet}
                </span>
                <span class="mt-1 block font-head text-lg leading-tight text-[var(--color-bone)]">«{item.q}»</span>
              </span>
              <span class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--color-line)] text-[var(--color-muted)] transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <div class="border-t border-[var(--color-line)] px-6 py-5">
              <p class="flex gap-3 text-sm leading-relaxed text-[var(--color-muted)]">
                <span class="font-head text-[var(--color-belt-gold)]">R.</span>
                <span>{item.a}</span>
              </p>
            </div>
          </details>
        ))
      }
    </div>

    <div
      data-reveal
      class="mt-8 flex flex-col items-center justify-between gap-4 rounded-2xl border border-[var(--color-line)] bg-[var(--color-panel)] p-6 sm:flex-row sm:p-8"
    >
      <p class="text-center font-head text-xl text-[var(--color-bone)] sm:text-left sm:text-2xl">
        ¿Alguna pregunta más? <span class="text-gold">La sala sigue abierta.</span>
      </p>
      <a href="#contrato" class="btn btn-primary w-full sm:w-auto">Pasar al contrato</a>
    </div>
  </div>
</section>
