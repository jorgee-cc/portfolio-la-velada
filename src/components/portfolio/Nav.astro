---
import Icon from '../ui/Icon.astro'
import Logo from '../ui/Logo.astro'
import { navLinks, site, socialLinks } from '../../data/site'
---

<header
  id="top"
  class="fixed inset-x-0 top-0 z-50 border-b border-[var(--color-line)]/70 bg-[var(--color-void)]/80 backdrop-blur-xl"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-10">
    <a href="/" class="group flex items-center gap-3" aria-label="Volver al menú de Netflix">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-md border border-[var(--color-belt-gold)]/60 bg-[var(--color-belt-gold)]/10"
        aria-hidden="true"
      >
        <Logo class="h-6 w-6 text-[var(--color-belt-gold)]" />
      </span>
      <span class="hidden flex-col leading-none sm:flex">
        <span class="font-head text-sm tracking-wide text-[var(--color-bone)]">JORGE CONDADO</span>
        <span class="font-mono text-[10px] tracking-[0.25em] text-[var(--color-ring-red)]">
          CANDIDATO · {site.candidate}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 xl:flex" aria-label="Navegación principal">
      {
        navLinks.map((l) => (
          <a
            href={l.href}
            class="rounded-full px-3.5 py-2 font-cond text-sm font-medium tracking-wide text-[var(--color-muted)] uppercase transition-colors hover:bg-white/5 hover:text-[var(--color-bone)]"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden items-center gap-1 border-l border-[var(--color-line)] pr-1 pl-3 sm:flex">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${social.label} de ${site.name}`}
              title={social.label}
              class="flex h-9 w-9 items-center justify-center rounded-md text-[var(--color-muted)] transition-colors hover:bg-white/5 hover:text-[var(--color-belt-gold)]"
            >
              <Icon path={social.icon} size={18} />
            </a>
          ))
        }
      </div>
      <a
        href="#contrato"
        class="btn btn-primary hidden !px-5 !py-2.5 !text-xs whitespace-nowrap sm:inline-flex"
        >Firmar el contrato</a
      >
      <button
        id="nav-toggle"
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-md border border-[var(--color-line)] text-[var(--color-bone)] xl:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon path="M3 6h18M3 12h18M3 18h18" size={20} strokeWidth={2} />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-[var(--color-line)] bg-[var(--color-ink)] xl:hidden"
    aria-label="Navegación móvil"
  >
    <div class="mx-auto flex max-w-7xl flex-col px-4 py-3 sm:px-6">
      {
        navLinks.map((l) => (
          <a
            href={l.href}
            class="rounded-lg px-3 py-3 font-cond text-sm font-medium tracking-wide text-[var(--color-muted)] uppercase transition-colors hover:bg-white/5 hover:text-[var(--color-bone)]"
          >
            {l.label}
          </a>
        ))
      }
      <a href="#contrato" class="btn btn-primary mt-2 w-full">Firmar el contrato</a>
      <div class="mt-3 flex items-center gap-2 border-t border-[var(--color-line)] pt-3">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noreferrer"
              class="flex items-center gap-2 rounded-lg border border-[var(--color-line)] px-3 py-2 font-cond text-xs tracking-wide text-[var(--color-muted)] uppercase transition-colors hover:border-[var(--color-belt-gold)]/50 hover:text-[var(--color-bone)]"
            >
              <Icon path={social.icon} size={16} />
              {social.label}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</header>

<script>
  import { initMobileNav } from '../../scripts/mobile-nav'

  initMobileNav()
</script>
