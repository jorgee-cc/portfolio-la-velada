---
import Section from '../ui/Section.astro'
import SectionHeader from '../ui/SectionHeader.astro'
import { rounds } from '../../data/content'
import { toneBorder, toneText } from '../../lib/tones'
---

<Section id="reto">
  <SectionHeader kicker="El reto · A doce asaltos" class="mb-14">
    Nadie firma un cartel<br /><span class="text-fire">sin ver la pelea</span>
    <span slot="subtitle">
      Dirigir la tecnología de La Velada no es hacer una web bonita. Es ganar seis asaltos seguidos
      sin margen de error, con todo el mundo mirando. Este es mi plan para cada round.
    </span>
  </SectionHeader>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      rounds.map((round) => (
        <article
          data-reveal
          class={`card group relative overflow-hidden p-6 ${toneBorder[round.tone]}`}
        >
          <span
            class={`pointer-events-none absolute -top-6 -right-3 font-head text-8xl opacity-10 ${toneText[round.tone]}`}
            aria-hidden="true"
          >
            {round.n}
          </span>
          <div class="flex items-center gap-3">
            <span class={`font-mono text-xs tracking-[0.25em] ${toneText[round.tone]}`}>
              ROUND {round.n}
            </span>
            <span class="rule-belt flex-1 opacity-40" />
          </div>
          <h3 class="mt-4 font-head text-2xl text-[var(--color-bone)]">{round.name}</h3>

          <div class="mt-5 space-y-4 text-sm">
            <div>
              <p class="font-mono text-[10px] tracking-[0.25em] text-[var(--color-faint)] uppercase">
                Lo que exige
              </p>
              <p class="mt-1 text-[var(--color-muted)]">{round.demand}</p>
            </div>
            <div>
              <p class="font-mono text-[10px] tracking-[0.25em] text-[var(--color-faint)] uppercase">
                Mi jugada
              </p>
              <p class="mt-1 text-[var(--color-bone)]">{round.play}</p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>
