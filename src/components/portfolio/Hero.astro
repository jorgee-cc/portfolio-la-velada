---
import Icon from '../ui/Icon.astro'
import Ticker from '../ui/Ticker.astro'
import { eventDate, heroTicker, pitchHtml } from '../../data/site'
import { tape } from '../../data/content'
---

<section id="cartel" class="relative z-10 overflow-hidden pt-28 pb-10 sm:pt-32">
  <div
    class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:gap-10 lg:px-10"
  >
    <!-- Columna izquierda: el anuncio -->
    <div class="text-center lg:text-left">
      <p data-reveal class="kicker mb-5 lg:tracking-[0.28em]">
        Ibai · La Velada del Año — Candidatura oficial 2027
      </p>

      <h1
        data-reveal
        class="headline text-[clamp(2.9rem,12vw,7.4rem)] lg:text-[clamp(2.6rem,9vw,7.4rem)]"
      >
        <span class="text-chrome block">El programador</span>
        <span class="relative block">
          <span class="text-gold animate-shine bg-[length:200%_auto]">que aguanta</span>
        </span>
        <span class="text-fire block">el main event</span>
      </h1>

      <p
        data-reveal
        class="mx-auto mt-7 max-w-xl text-base leading-relaxed text-[var(--color-muted)] sm:text-lg lg:mx-0"
      >
        <Fragment set:html={pitchHtml} />
      </p>

      <div
        data-reveal
        class="mt-9 flex flex-wrap items-center justify-center gap-3 lg:justify-start"
      >
        <a href="#contrato" class="btn btn-primary">
          Contrátame para el cartel
          <Icon path="M5 12h14M13 6l6 6-6 6" size={18} strokeWidth={2} />
        </a>
        <a href="#candidaturas" class="btn btn-ghost">Ver mis candidaturas</a>
      </div>

      <!-- Cuenta atrás -->
      <div
        data-reveal
        class="mt-10 inline-flex flex-wrap items-center gap-4 rounded-2xl border border-[var(--color-line)] bg-[var(--color-ink)]/70 px-5 py-4 backdrop-blur"
      >
        <div class="flex items-center gap-2">
          <span class="relative flex h-2.5 w-2.5">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-ring-red)] opacity-75"
            ></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[var(--color-ring-red)]"
            ></span>
          </span>
          <span class="font-mono text-[11px] tracking-[0.25em] text-[var(--color-muted)] uppercase"
            >Cuenta atrás</span
          >
        </div>
        <div
          id="countdown"
          data-target={eventDate}
          class="flex items-center gap-3 font-head text-2xl text-[var(--color-bone)] sm:text-3xl"
        >
          <span data-cd="days">--</span><span class="font-mono text-xs text-[var(--color-faint)]"
            >D</span
          >
          <span data-cd="hours">--</span><span class="font-mono text-xs text-[var(--color-faint)]"
            >H</span
          >
          <span data-cd="mins">--</span><span class="font-mono text-xs text-[var(--color-faint)]"
            >M</span
          >
          <span data-cd="secs">--</span><span class="font-mono text-xs text-[var(--color-faint)]"
            >S</span
          >
        </div>
      </div>
    </div>

    <!-- Columna derecha: el cartel / tale of the tape -->
    <div data-reveal class="relative mx-auto w-full max-w-sm">
      <div
        class="pointer-events-none absolute -inset-6 rounded-[2rem] bg-[conic-gradient(from_0deg,rgba(255,45,63,0.35),transparent_30%,rgba(47,107,255,0.35),transparent_60%,rgba(246,195,67,0.4),transparent)] opacity-60 blur-2xl"
        aria-hidden="true"
      >
      </div>

      <div
        class="scanlines relative overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-panel)]"
      >
        <div
          class="flex items-center justify-between border-b border-[var(--color-line)] px-5 py-3"
        >
          <span class="font-mono text-[10px] tracking-[0.25em] text-[var(--color-muted)]"
            >CARTEL · MAIN EVENT</span
          >
          <span class="font-mono text-[10px] tracking-[0.25em] text-[var(--color-belt-gold)]"
            >#00001</span
          >
        </div>

        <div class="flex items-stretch gap-3 px-5 pt-6">
          <!-- Esquina roja -->
          <div class="flex flex-1 flex-col items-center text-center">
            <div
              class="h-24 w-24 overflow-hidden rounded-full border-2 border-[var(--color-ring-red)]/70 shadow-[0_0_40px_-8px_rgba(255,45,63,0.7)]"
            >
              <img
                src="/images/1726564320490.jpeg"
                alt="Jorge Condado Carballo"
                class="h-full w-full object-cover"
                width="96"
                height="96"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <p class="mt-3 font-head text-lg leading-none text-[var(--color-ring-red)]">
              JORGE<br />CONDADO
            </p>
            <p class="mt-1 font-mono text-[10px] tracking-widest text-[var(--color-muted)]">
              ESQUINA ROJA
            </p>
          </div>

          <div class="flex flex-col items-center justify-center">
            <span class="font-head text-4xl text-[var(--color-bone)]">VS</span>
          </div>

          <!-- Esquina azul -->
          <div class="flex flex-1 flex-col items-center text-center">
            <div
              class="flex h-24 w-24 animate-float items-center justify-center rounded-full border-2 border-[var(--color-ring-blue)]/60 bg-[var(--color-void)] font-head text-3xl text-[var(--color-ring-blue)]"
            >
              30K
            </div>
            <p class="mt-3 font-head text-lg leading-none text-[var(--color-ring-blue)]">
              LA<br />COMPETENCIA
            </p>
            <p class="mt-1 font-mono text-[10px] tracking-widest text-[var(--color-muted)]">
              ESQUINA AZUL
            </p>
          </div>
        </div>

        <div class="mt-6 divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
          {
            tape.map((row) => (
              <div class="grid grid-cols-2 items-center gap-x-3 gap-y-1 px-5 py-2.5 sm:grid-cols-[1fr_auto_1fr] sm:gap-2">
                <span class="col-span-2 text-center font-mono text-[10px] tracking-widest text-[var(--color-faint)] uppercase sm:order-2 sm:col-span-1 sm:px-2">
                  {row.label}
                </span>
                <span class="min-w-0 text-left text-sm font-semibold text-[var(--color-bone)] sm:order-1 sm:text-right">
                  {row.me}
                </span>
                <span class="min-w-0 text-right text-sm text-[var(--color-muted)] line-through decoration-[var(--color-ring-red)]/50 sm:order-3 sm:text-left">
                  {row.rival}
                </span>
              </div>
            ))
          }
        </div>

        <div
          class="border-t border-[var(--color-line)] bg-[var(--color-void)]/60 px-5 py-4 text-center"
        >
          <p class="font-cond text-sm tracking-[0.2em] text-[var(--color-belt-gold)] uppercase">
            El cinturón: el puesto oficial
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-14">
    <Ticker items={heroTicker} tone="gold" />
  </div>
</section>

<script>
  import { startCountdown } from '../../scripts/countdown'

  startCountdown(document.getElementById('countdown'))
</script>
