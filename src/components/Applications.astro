---
import SectionHeader from './ui/SectionHeader.astro'
import Tag from './ui/Tag.astro'
import { applications, results } from '../data/projects'
---

<section id="candidaturas" class="relative z-10 border-t border-[var(--color-line)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <SectionHeader kicker="Candidaturas · No es mi primera vez en el ring" class="mb-14">
      Ya me presenté<br /><span class="text-fire">con estos dos golpes</span>
      <span slot="subtitle">
        Antes de postularme a este cartel, ya había entrado al proceso. Estos son los dos proyectos
        frontend con los que me presenté como programador — por
        <strong class="text-[var(--color-bone)]">InfoJobs</strong> y por
        <strong class="text-[var(--color-bone)]">midudev</strong> — y lo que dejaron.
      </span>
    </SectionHeader>

    <div class="grid gap-6 lg:grid-cols-2">
      {
        applications.map((app) => (
          <article data-reveal class="card flex flex-col overflow-hidden p-0">
            <div class="relative aspect-video overflow-hidden border-b border-[var(--color-line)]">
              <img
                src={app.img}
                alt={app.title}
                class="h-full w-full object-cover opacity-90"
                width="800"
                height="450"
                loading="lazy"
                decoding="async"
              />
              <span class="absolute left-4 top-4 rounded-full bg-[var(--color-ring-red)] px-3 py-1 font-mono text-[10px] tracking-[0.2em] text-white">
                {app.badge}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-7">
              <h3 class="font-head text-2xl text-[var(--color-bone)] sm:text-3xl">{app.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">{app.desc}</p>

              <div class="mt-5 flex flex-wrap gap-2">
                {app.tags.map((t) => <Tag>{t}</Tag>)}
              </div>

              <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-[var(--color-line)] pt-4">
                <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-[var(--color-faint)]">Canal</span>
                {app.channels?.map((c) => (
                  <span class="rounded-full border border-[var(--color-belt-gold)]/40 bg-[var(--color-belt-gold)]/10 px-3 py-1 font-cond text-xs font-semibold uppercase tracking-wide text-[var(--color-belt-gold)]">
                    {c}
                  </span>
                ))}
              </div>

              <a
                href={app.link}
                target="_blank"
                rel="noreferrer"
                class="mt-5 inline-flex items-center gap-2 font-cond text-sm font-semibold uppercase tracking-wide text-[var(--color-belt-gold)] transition-colors hover:text-[var(--color-bone)]"
              >
                Ver el proyecto en vivo <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- El resultado -->
    <div
      data-reveal
      class="relative mt-8 overflow-hidden rounded-2xl border border-[var(--color-belt-gold)]/40 bg-[var(--color-ink)] p-7 sm:p-10"
    >
      <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-[var(--color-belt-gold)]/15 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-center">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.3em] text-[var(--color-belt-gold)]">El resultado</p>
          <p class="mt-3 font-head text-3xl leading-tight text-[var(--color-bone)] sm:text-4xl">
            El año pasado pasé el filtro de las <span class="text-gold">30.000 candidaturas</span>.
          </p>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-[var(--color-muted)] sm:text-base">
            Me llamaron. Y en el evento de <strong class="text-[var(--color-bone)]">Capgemini</strong> hablé
            directamente con <strong class="text-[var(--color-bone)]">midudev</strong>, que me situó como
            mínimo en el <strong class="text-[var(--color-belt-gold)]">top 70-80</strong> de todas las
            candidaturas. No fue suerte: fue interés, trabajo y estar ahí cuando importaba. Este año vuelvo
            con más cartel y mejores golpes.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 lg:grid-cols-1">
          {
            results.map((r) => (
              <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-void)]/60 px-5 py-4 text-center lg:text-left">
                <p class="font-head text-3xl text-[var(--color-belt-gold)]">{r.value}</p>
                <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-muted)]">{r.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
