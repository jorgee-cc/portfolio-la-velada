---
/**
 * Introducción cinematográfica basada en `netflix-intro-animation-pure-css`.
 *
 * La animación original construye una letra de Netflix con cuatro columnas de
 * "pinceladas". Aquí se conservan esas pinceladas, las luces y el zoom final,
 * pero el protagonista es LogoPersonal.svg. Como el SVG original tiene relleno
 * negro, se aplica como máscara CSS y se pinta con el degradado de la marca.
 */
const furs = [
  [0, 3.8, 15],
  [3.8, 2.8, 10],
  [6.6, 4.8, 37],
  [11.4, 4, 23],
  [15.4, 4, 15],
  [19.4, 2.5, 27],
  [21.9, 4, 20],
  [25.9, 2, 30],
  [27.9, 4, 35],
  [31.9, 3.5, 39],
  [35.4, 2, 34],
  [37.4, 2.6, 22],
  [40, 6, 47],
  [46, 2, 36],
  [48, 5.5, 29],
  [53.5, 3, 39],
  [56.5, 4.1, 45],
  [60.6, 2.4, 34],
  [63, 4, 47],
  [67, 1.5, 27],
  [68.5, 2.8, 37],
  [71.3, 2.3, 9],
  [73.6, 2.2, 28],
  [75.8, 1, 37],
  [76.8, 2.1, 28],
  [78.9, 4.1, 34],
  [83, 2.5, 21],
  [85.5, 4.5, 39],
  [90, 2.8, 30],
  [92.8, 3.5, 19],
  [96.3, 3.7, 37],
]

const lamps = [
  [0.7, 1],
  [2.2, 1.4],
  [5.8, 2.1],
  [10.1, 2],
  [12.9, 1.4],
  [15.3, 2.8],
  [21.2, 2.5],
  [25, 2.5],
  [30.5, 3],
  [36.3, 3],
  [41, 2.2],
  [44.2, 2.6],
  [51.7, 0.5],
  [52.1, 1.8],
  [53.8, 2.3],
  [57.2, 2],
  [62.3, 2.9],
  [65.8, 1.7],
  [72.8, 0.8],
  [74.3, 2],
  [79.8, 2],
  [78.2, 2],
  [78.5, 2],
  [85.3, 1.1],
  [86.9, 1.1],
  [88.8, 2],
  [92.4, 2.4],
  [96.2, 2.1],
]

const lampColors = ['#f6c343', '#ff2d3f', '#2f6bff', '#f3f1ea', '#a97d1a']
const helpers = [1, 2, 3, 4]
---

<div class="intro" data-intro>
  <div class="intro__stage" data-intro-stage>
    <div class="intro__aura" aria-hidden="true"></div>

    <div class="intro__brushes" aria-hidden="true">
      {
        helpers.map((helper) => (
          <div class={`helper helper-${helper}`}>
            <div class="effect-brush">
              {furs.map(([left, width, stop]) => (
                <span class="fur" style={`--left:${left}%;--width:${width}%;--stop:${stop}%`} />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="intro__lights" aria-hidden="true">
      {
        lamps.map(([left, width], index) => (
          <span
            class="lamp"
            style={`--left:${left}%;--width:${width}%;--lamp:${lampColors[index % lampColors.length]};--i:${index}`}
          />
        ))
      }
    </div>

    <div class="intro__mark-wrap">
      <div class="intro__mark logo-mark" role="img" aria-label="Jorge Condado"></div>
      <div class="intro__sheen logo-mark" aria-hidden="true">
        <span class="intro__sheen-bar"></span>
      </div>
    </div>
  </div>

  <p class="intro__caption" aria-hidden="true">Jorge Condado · El portfolio</p>
  <button type="button" class="intro__skip" data-intro-skip> Saltar introducción </button>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #000;
    isolation: isolate;
    contain: layout paint;
    transition: opacity 0.6s ease;
  }

  .intro.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  /* Watch Now: tras el zoom, el logo se funde a negro antes de entrar en el
     portfolio, para que la transición no muestre la landing de fondo. */
  .intro.is-entering-portfolio .intro__stage {
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  .intro.is-entering-portfolio .intro__caption,
  .intro.is-entering-portfolio .intro__skip {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .intro__stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 300px;
    height: 300px;
    overflow: hidden;
    transform-origin: center center;
    backface-visibility: hidden;
    contain: paint;
    animation: intro-zoom 3.5s ease-in 0.5s forwards;
    will-change: transform;
  }

  .intro__aura {
    position: absolute;
    width: 560px;
    height: 560px;
    border-radius: 9999px;
    background: radial-gradient(
      circle,
      rgba(246, 195, 67, 0.3) 0%,
      rgba(255, 45, 63, 0.12) 42%,
      transparent 70%
    );
    opacity: 0;
    animation: intro-aura 3.4s ease-in-out 0.2s forwards;
    will-change: transform, opacity;
  }

  .intro__brushes {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: intro-brushes 0.9s ease 0.2s forwards;
    will-change: opacity;
  }

  .helper {
    position: absolute;
    top: -12%;
    height: 124%;
    width: 16%;
    overflow: hidden;
  }

  .helper-1 {
    left: 6%;
    transform: rotate(-6deg);
  }
  .helper-2 {
    left: 30%;
    transform: rotate(4deg);
  }
  .helper-3 {
    left: 54%;
    transform: rotate(-4deg);
  }
  .helper-4 {
    left: 78%;
    transform: rotate(6deg);
  }

  .effect-brush {
    position: absolute;
    top: 0;
    width: 100%;
    height: 300%;
    overflow: hidden;
    animation: intro-brush 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    will-change: transform;
  }

  .helper-1 .effect-brush {
    animation-delay: 0.35s;
  }
  .helper-2 .effect-brush {
    animation-delay: 0.55s;
  }
  .helper-3 .effect-brush {
    animation-delay: 0.45s;
  }
  .helper-4 .effect-brush {
    animation-delay: 0.65s;
  }

  .effect-brush::before {
    content: '';
    position: absolute;
    top: 0;
    left: -30%;
    width: 160%;
    height: 70%;
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(255, 45, 63, 0.55) 16%,
      #ff2d3f 34%,
      #ff2d3f 66%,
      rgba(255, 45, 63, 0.55) 84%,
      transparent 100%
    );
  }

  .fur {
    position: absolute;
    bottom: 10%;
    left: var(--left);
    display: block;
    width: var(--width);
    height: 30%;
    background: linear-gradient(to bottom, #ff2d3f 0%, #ff2d3f var(--stop), transparent 100%);
  }

  .intro__lights {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: intro-lights 2s ease 1.35s forwards;
  }

  .lamp {
    position: absolute;
    top: 0;
    left: var(--left);
    display: block;
    width: var(--width);
    height: 100%;
    background: linear-gradient(
      to right,
      transparent 0%,
      var(--lamp) 25%,
      var(--lamp) 75%,
      transparent 100%
    );
    opacity: 0.85;
    animation: intro-lamp-left 3.2s ease-in-out calc(var(--i) * -0.19s) infinite alternate;
    will-change: transform;
  }

  .lamp:nth-child(even) {
    animation-name: intro-lamp-right;
  }

  .intro__mark-wrap {
    position: relative;
    z-index: 2;
    display: grid;
    width: 84%;
    overflow: hidden;
    contain: paint;
    transform: translateZ(0);
  }

  .intro__mark {
    grid-area: 1 / 1;
    width: 100%;
    background: linear-gradient(155deg, #ffffff 0%, #f6c343 46%, #ff2d3f 100%);
    opacity: 0;
    transform: translate3d(0, 105%, 0) scale(0.97);
    animation: intro-mark-reveal 1.35s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
    will-change: transform, opacity;
  }

  .intro__sheen {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: none;
    pointer-events: none;
  }

  .intro__sheen-bar {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 45%;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.6), transparent);
    opacity: 0;
    animation: intro-sheen 1.4s ease-in 0.3s forwards;
    will-change: transform, opacity;
  }

  .intro__caption {
    position: absolute;
    bottom: clamp(1.1rem, 4vw, 2rem);
    left: clamp(1rem, 5vw, 3rem);
    margin: 0;
    color: rgba(243, 241, 234, 0.62);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    animation: intro-caption 3.5s ease forwards;
  }

  .intro__skip {
    position: absolute;
    right: clamp(1rem, 5vw, 3rem);
    bottom: clamp(1rem, 4vw, 1.7rem);
    padding: 0.55rem 0.9rem;
    border: 1px solid rgba(243, 241, 234, 0.24);
    border-radius: 9999px;
    background: transparent;
    color: rgba(243, 241, 234, 0.72);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .intro__skip:hover {
    border-color: rgba(246, 195, 67, 0.7);
    background: rgba(246, 195, 67, 0.08);
    color: #fff;
  }

  @keyframes intro-zoom {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(15);
    }
  }

  @keyframes intro-brush {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-100%);
    }
  }

  @keyframes intro-brushes {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 0.52;
    }
  }

  @keyframes intro-aura {
    0% {
      opacity: 0;
      transform: scale(0.85);
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0.85;
      transform: scale(1.08);
    }
  }

  @keyframes intro-lights {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes intro-lamp-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(34px) scaleX(2.4);
    }
  }

  @keyframes intro-lamp-right {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-34px) scaleX(2.4);
    }
  }

  @keyframes intro-mark-reveal {
    0% {
      opacity: 0;
      transform: translate3d(0, 105%, 0) scale(0.97);
    }
    18% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes intro-sheen {
    0% {
      transform: translate3d(0, 0, 0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    100% {
      transform: translate3d(0, -320%, 0);
      opacity: 0;
    }
  }

  @keyframes intro-caption {
    0% {
      opacity: 0;
    }
    22% {
      opacity: 1;
    }
    74% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 520px) {
    .intro__caption {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .intro__stage {
      width: 250px;
      height: 250px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none;
    }
  }
</style>

<script>
  const intro = document.querySelector<HTMLElement>('[data-intro]')
  const root = document.documentElement
  const landing = document.querySelector<HTMLElement>('[data-landing]')
  const watchMode = new URLSearchParams(window.location.search).get('watch') === '1'
  const enterPortfolio = () => window.location.replace('/portfolio')

  if (intro) {
    if (root.classList.contains('intro-skip')) {
      intro.remove()
      if (watchMode) enterPortfolio()
    } else {
      const stage = intro.querySelector<HTMLElement>('[data-intro-stage]')
      const skip = intro.querySelector<HTMLButtonElement>('[data-intro-skip]')
      let finished = false

      if (landing) landing.setAttribute('inert', '')

      const finish = (immediate = false) => {
        if (finished) return
        finished = true

        // Watch Now: la intro se reproduce y, al acabar, entra en el portfolio.
        if (watchMode) {
          if (immediate) {
            enterPortfolio()
            return
          }

          intro.classList.add('is-entering-portfolio')
          intro.setAttribute('aria-hidden', 'true')
          window.setTimeout(enterPortfolio, 480)
          return
        }

        if (landing) landing.removeAttribute('inert')
        root.classList.add('intro-done')
        intro.classList.add('is-leaving')
        intro.setAttribute('aria-hidden', 'true')

        if (immediate) {
          intro.remove()
          return
        }

        intro.addEventListener(
          'transitionend',
          (event) => {
            if (event.target === intro && (event as TransitionEvent).propertyName === 'opacity') {
              intro.remove()
            }
          },
          { once: true },
        )
        window.setTimeout(() => intro.remove(), 1000)
      }

      // El zoom original termina a los 4 s (0,5 s de espera + 3,5 s de animación).
      stage?.addEventListener('animationend', (event) => {
        if (event.target === stage) finish()
      })
      skip?.addEventListener('click', () => finish(watchMode))
      window.setTimeout(() => finish(), 4800)

      // Si el usuario activa "movimiento reducido" con la página abierta,
      // la intro desaparece sin dejar la landing bloqueada por `inert`.
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
      if (reducedMotion.matches) finish(true)
      reducedMotion.addEventListener('change', (event) => {
        if (event.matches) finish(true)
      })
    }
  }
</script>
