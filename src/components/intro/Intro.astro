---
/**
 * Introducción cinematográfica inspirada en el ident de Netflix.
 *
 * La animación original construía la escena con ~150 nodos (una etiqueta por
 * pincelada y por lámpara) y hacía zoom ×15 sobre todos ellos. Eso obligaba al
 * navegador a repintar la escena completa en cada frame.
 *
 * Ahora la escena son una docena de nodos que solo animan `transform` y
 * `opacity`:
 * - Las pinceladas se generan aquí como un único SVG data-URI, así que se
 *   rasterizan una sola vez en lugar de pintar 124 elementos.
 * - Las lámparas son dos capas de franjas estáticas con máscara radial, no 28
 *   nodos animados por separado.
 * - Todas las animaciones internas (pinceles, luces, brillo) terminan antes
 *   del zoom final: así el zoom es una única capa compuesta en la GPU.
 * - El zoom se limita a ×7 y la escena se funde a negro al terminar, antes de
 *   que el navegador llegue a re-rasterizar a resolución completa.
 */
import { beamColumns, furStrokes } from './intro-data'

const furRects = furStrokes
  .map(([left, width, intensity]) => {
    const height = (16 + intensity * 0.4).toFixed(1)
    const opacity = (0.22 + intensity * 0.016).toFixed(2)

    return `<rect x="${left}" y="${(100 - Number(height)).toFixed(1)}" width="${width}" height="${height}" opacity="${opacity}"/>`
  })
  .join('')

const beamTexture = [
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none">',
  '<defs>',
  '<linearGradient id="c" x1="0" y1="0" x2="0" y2="1">',
  '<stop offset="0" stop-color="#ff2d3f" stop-opacity="0"/>',
  '<stop offset=".32" stop-color="#ff2d3f" stop-opacity=".55"/>',
  '<stop offset=".72" stop-color="#ff2d3f" stop-opacity=".9"/>',
  '<stop offset="1" stop-color="#ff2d3f" stop-opacity="0"/>',
  '</linearGradient>',
  '<linearGradient id="e" x1="0" y1="0" x2="1" y2="0">',
  '<stop offset="0" stop-color="#fff" stop-opacity="0"/>',
  '<stop offset=".14" stop-color="#fff" stop-opacity=".92"/>',
  '<stop offset=".86" stop-color="#fff" stop-opacity=".92"/>',
  '<stop offset="1" stop-color="#fff" stop-opacity="0"/>',
  '</linearGradient>',
  '<mask id="m"><rect width="100" height="100" fill="url(#e)"/></mask>',
  '</defs>',
  '<g mask="url(#m)" fill="#ff2d3f">',
  '<rect width="100" height="100" fill="url(#c)"/>',
  furRects,
  '</g>',
  '</svg>',
].join('')

// Sin comillas: el data-URI viaja dentro de un atributo `style` y así no hay
// que escapar nada. Los paréntesis se codifican también porque, sin comillas,
// romperían el token `url()` y el navegador descartaría la declaración.
const beamImage = `url(data:image/svg+xml,${encodeURIComponent(beamTexture).replace(
  /[()']/g,
  (char) => `%${char.charCodeAt(0).toString(16).toUpperCase()}`,
)})`
---

<div class="intro" data-intro>
  <div class="intro__stage" data-intro-stage style={`--beam:${beamImage}`}>
    <div class="intro__aura" aria-hidden="true"></div>

    <div class="intro__brushes" aria-hidden="true">
      {
        beamColumns.map((beam) => (
          <span
            class="beam"
            style={`--x:${beam.left}%;--w:${beam.width}%;--delay:${beam.delay}s;--tilt:${beam.tilt}deg;--alpha:${beam.alpha}`}
          />
        ))
      }
    </div>

    <div class="intro__lights" aria-hidden="true">
      <span class="intro__lamp intro__lamp--warm"></span>
      <span class="intro__lamp intro__lamp--cool"></span>
    </div>

    <div class="intro__mark-wrap">
      <div class="intro__mark logo-mark" role="img" aria-label="Jorge Condado"></div>
      <div class="intro__sheen logo-mark" aria-hidden="true">
        <span class="intro__sheen-bar"></span>
      </div>
    </div>
  </div>

  <p class="intro__caption" aria-hidden="true">Jorge Condado · El portfolio</p>
  <button type="button" class="intro__skip" data-intro-skip> Saltar introducción </button>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #000;
    isolation: isolate;
    contain: layout paint;
    transition: opacity 0.5s ease;
  }

  .intro.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  /* Watch Now: tras el zoom, el logo se funde a negro antes de entrar en el
     portfolio, para que la transición no muestre la landing de fondo. */
  .intro.is-entering-portfolio .intro__stage {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .intro.is-entering-portfolio .intro__caption,
  .intro.is-entering-portfolio .intro__skip {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .intro__stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 300px;
    height: 300px;
    transform-origin: center center;
    backface-visibility: hidden;
    /* El zoom arranca cuando pinceles, luces y brillo ya han terminado. */
    animation: intro-zoom 1.15s cubic-bezier(0.62, 0, 0.2, 1) 2.15s both;
    will-change: transform;
  }

  .intro__aura {
    position: absolute;
    width: 620px;
    height: 620px;
    border-radius: 9999px;
    background: radial-gradient(
      circle,
      rgba(246, 195, 67, 0.3) 0%,
      rgba(255, 45, 63, 0.16) 42%,
      transparent 68%
    );
    opacity: 0;
    animation: intro-aura 1.9s ease-out 0.2s forwards;
    will-change: transform, opacity;
  }

  /* Cada columna lleva su textura ya dibujada: no hay nodos hijos que pintar. */
  .intro__brushes {
    position: absolute;
    inset: 0;
  }

  .beam {
    position: absolute;
    top: 0;
    left: var(--x);
    display: block;
    width: var(--w);
    height: 100%;
    background-image: var(--beam);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    opacity: 0;
    transform: translate3d(0, 118%, 0) rotate(var(--tilt)) scaleY(0.92);
    transform-origin: 50% 100%;
    animation: intro-beam 1.15s cubic-bezier(0.22, 0.8, 0.24, 1) var(--delay) forwards;
    will-change: transform, opacity;
    pointer-events: none;
  }

  .intro__lights {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    -webkit-mask-image: radial-gradient(
      closest-side at 50% 46%,
      #000 0%,
      rgba(0, 0, 0, 0.7) 60%,
      transparent 100%
    );
    mask-image: radial-gradient(
      closest-side at 50% 46%,
      #000 0%,
      rgba(0, 0, 0, 0.7) 60%,
      transparent 100%
    );
    /* Se enciende tras los pinceles y se atenúa durante el zoom final. */
    animation: intro-lights 2.5s ease-out 0.8s both;
    pointer-events: none;
  }

  /* Dos capas de franjas suaves con periodos distintos; solo cambian de
     opacidad, así que no obligan a repintar la máscara. */
  .intro__lamp {
    position: absolute;
    inset: 0;
    display: block;
  }

  .intro__lamp--warm {
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0 5px,
      rgba(246, 195, 67, 0.24) 11px,
      transparent 17px 25px,
      rgba(255, 45, 63, 0.2) 31px,
      transparent 37px 46px,
      rgba(243, 241, 234, 0.14) 52px,
      transparent 58px 67px
    );
  }

  .intro__lamp--cool {
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0 7px,
      rgba(47, 107, 255, 0.16) 15px,
      transparent 23px 34px,
      rgba(246, 195, 67, 0.16) 41px,
      transparent 48px 57px
    );
    animation: intro-lamp-pulse 0.8s ease-in-out 1s 2 alternate both;
  }

  .intro__mark-wrap {
    position: relative;
    z-index: 2;
    display: grid;
    width: 84%;
    overflow: hidden;
    contain: paint;
    transform: translateZ(0);
  }

  .intro__mark {
    grid-area: 1 / 1;
    width: 100%;
    background: linear-gradient(155deg, #ffffff 0%, #f6c343 46%, #ff2d3f 100%);
    opacity: 0;
    transform: translate3d(0, 105%, 0) scale(0.97);
    animation: intro-mark-reveal 1.05s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    will-change: transform, opacity;
  }

  .intro__sheen {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: none;
    pointer-events: none;
  }

  .intro__sheen-bar {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 45%;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.6), transparent);
    opacity: 0;
    animation: intro-sheen 1s ease-in 1s forwards;
  }

  .intro__caption {
    position: absolute;
    bottom: clamp(1.1rem, 4vw, 2rem);
    left: clamp(1rem, 5vw, 3rem);
    margin: 0;
    color: rgba(243, 241, 234, 0.62);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    animation: intro-caption 2.3s ease 0.25s both;
  }

  .intro__skip {
    position: absolute;
    right: clamp(1rem, 5vw, 3rem);
    bottom: clamp(1rem, 4vw, 1.7rem);
    padding: 0.55rem 0.9rem;
    border: 1px solid rgba(243, 241, 234, 0.24);
    border-radius: 9999px;
    background: transparent;
    color: rgba(243, 241, 234, 0.72);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .intro__skip:hover {
    border-color: rgba(246, 195, 67, 0.7);
    background: rgba(246, 195, 67, 0.08);
    color: #fff;
  }

  @keyframes intro-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(7);
    }
  }

  @keyframes intro-beam {
    0% {
      opacity: 0;
      visibility: visible;
      transform: translate3d(0, 118%, 0) rotate(var(--tilt)) scaleY(0.92);
    }
    16% {
      opacity: var(--alpha);
    }
    64% {
      opacity: var(--alpha);
    }
    100% {
      opacity: 0;
      visibility: hidden;
      transform: translate3d(0, -118%, 0) rotate(var(--tilt)) scaleY(1.06);
    }
  }

  @keyframes intro-aura {
    0% {
      opacity: 0;
      transform: scale(0.82);
    }
    45% {
      opacity: 0.95;
      transform: scale(1);
    }
    100% {
      opacity: 0.6;
      transform: scale(1.12);
    }
  }

  @keyframes intro-lights {
    0% {
      opacity: 0;
    }
    26% {
      opacity: 1;
    }
    62% {
      opacity: 1;
    }
    100% {
      opacity: 0.35;
    }
  }

  @keyframes intro-lamp-pulse {
    from {
      opacity: 0.45;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes intro-mark-reveal {
    0% {
      opacity: 0;
      transform: translate3d(0, 105%, 0) scale(0.97);
    }
    18% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes intro-sheen {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0);
    }
    15% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate3d(0, -320%, 0);
    }
  }

  @keyframes intro-caption {
    0% {
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    72% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 520px) {
    .intro__caption {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .intro__stage {
      width: 250px;
      height: 250px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none;
    }
  }
</style>

<script>
  import { initIntro } from '../../scripts/intro'

  initIntro()
</script>
