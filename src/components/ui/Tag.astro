---
interface Props {
  variant?: 'outline' | 'plain'
  size?: 'sm' | 'md'
  class?: string
}

const { variant = 'outline', size = 'md', class: className = '' } = Astro.props

const sizes = {
  sm: 'px-2 py-0.5 text-[11px]',
  md: 'px-2.5 py-1 text-xs',
}
const variants = {
  outline: 'border border-[var(--color-line)] bg-[var(--color-void)]',
  plain: 'bg-[var(--color-void)]',
}
---

<span
  class={`rounded font-mono text-[var(--color-muted)] ${sizes[size]} ${variants[variant]} ${className}`}
>
  <slot />
</span>
