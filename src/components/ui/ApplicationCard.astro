---
import Tag from './Tag.astro'
import type { Project } from '../../data/projects'

interface Props {
  application: Project
}

const { application } = Astro.props
---

<article data-reveal class="card flex flex-col overflow-hidden p-0">
  <div class="relative aspect-video overflow-hidden border-b border-[var(--color-line)]">
    <img
      src={application.img}
      alt={application.title}
      class="h-full w-full object-cover opacity-90"
      width="800"
      height="450"
      loading="lazy"
      decoding="async"
    />
    {
      application.badge && (
        <span class="absolute top-4 left-4 max-w-[calc(100%-2rem)] rounded-full bg-[var(--color-ring-red)] px-3 py-1 text-center font-mono text-[10px] leading-snug tracking-[0.2em] text-white">
          {application.badge}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-7">
    <h3 class="font-head text-2xl text-[var(--color-bone)] sm:text-3xl">{application.title}</h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">{application.desc}</p>

    <div class="mt-5 flex flex-wrap gap-2">
      {application.tags.map((tag) => <Tag>{tag}</Tag>)}
    </div>

    {
      application.channels?.length ? (
        <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-[var(--color-line)] pt-4">
          <span class="font-mono text-[10px] tracking-[0.25em] text-[var(--color-faint)] uppercase">
            Canal
          </span>
          {application.channels.map((channel) => (
            <span class="rounded-full border border-[var(--color-belt-gold)]/40 bg-[var(--color-belt-gold)]/10 px-3 py-1 font-cond text-xs font-semibold tracking-wide text-[var(--color-belt-gold)] uppercase">
              {channel}
            </span>
          ))}
        </div>
      ) : null
    }

    <a
      href={application.link}
      target="_blank"
      rel="noreferrer"
      class="mt-5 inline-flex items-center gap-2 font-cond text-sm font-semibold tracking-wide text-[var(--color-belt-gold)] uppercase transition-colors hover:text-[var(--color-bone)]"
    >
      Ver el proyecto en vivo <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
