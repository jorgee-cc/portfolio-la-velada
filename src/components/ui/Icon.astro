---
interface Props {
  path: string
  size?: number
  strokeWidth?: number
  class?: string
}

const { path, size = 20, strokeWidth = 1.6, class: className = '' } = Astro.props
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  class={className}
  aria-hidden="true"
>
  <path d={path} stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
