---
/**
 * Capas ambientales del portfolio: luz de focos, viñeta y grano.
 * Son puramente decorativas y no capturan interacción.
 */
---

<div class="pointer-events-none fixed inset-0 z-0" aria-hidden="true">
  <div
    class="absolute inset-0 bg-[radial-gradient(120%_80%_at_50%_-10%,rgba(255,45,63,0.14),transparent_55%),radial-gradient(90%_70%_at_50%_120%,rgba(47,107,255,0.14),transparent_55%)]"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(100%_100%_at_50%_50%,transparent_55%,rgba(0,0,0,0.85))]"
  >
  </div>
</div>
<div class="grain pointer-events-none fixed inset-0 z-[1] opacity-[0.05]" aria-hidden="true"></div>
