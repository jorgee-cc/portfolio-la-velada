---
import Tag from './Tag.astro'
import type { Project } from '../../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<article data-reveal class="card flex flex-col overflow-hidden p-0 sm:flex-row">
  <div
    class="relative w-full overflow-hidden border-b border-[var(--color-line)] sm:w-2/5 sm:border-r sm:border-b-0"
  >
    <img
      src={project.img}
      alt={project.title}
      class="h-full w-full object-cover"
      width="400"
      height="400"
      loading="lazy"
      decoding="async"
    />
    <span
      class="absolute top-3 left-3 rounded-full bg-[var(--color-ring-blue)] px-2.5 py-1 font-mono text-[9px] tracking-[0.2em] text-white"
    >
      SEMIFINAL
    </span>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <p class="font-mono text-[11px] tracking-[0.25em] text-[var(--color-belt-gold)]">
      {project.tag}
    </p>
    <h3 class="mt-2 font-head text-xl text-[var(--color-bone)]">{project.title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">{project.desc}</p>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {
        project.tags.map((tag) => (
          <Tag size="sm" variant="plain">
            {tag}
          </Tag>
        ))
      }
    </div>

    <a
      href={project.link}
      target="_blank"
      rel="noreferrer"
      class="mt-4 inline-flex items-center gap-2 font-cond text-xs font-semibold tracking-wide text-[var(--color-muted)] uppercase transition-colors hover:text-[var(--color-bone)]"
    >
      {project.cta ?? 'Ver combate'}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
