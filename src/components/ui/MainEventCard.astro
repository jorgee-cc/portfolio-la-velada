---
import Tag from './Tag.astro'
import type { Project } from '../../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<article data-reveal class="card mb-6 grid overflow-hidden p-0 lg:grid-cols-2">
  <div
    class="relative min-h-[16rem] overflow-hidden border-b border-[var(--color-line)] lg:border-r lg:border-b-0"
  >
    <img
      src={project.img}
      alt={project.title}
      class="h-full w-full object-cover"
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
    />
    <span
      class="absolute top-4 left-4 rounded-full bg-[var(--color-ring-red)] px-3 py-1 font-mono text-[10px] tracking-[0.2em] text-white"
    >
      MAIN EVENT
    </span>
  </div>

  <div class="flex flex-col justify-center p-7 sm:p-10">
    <p class="font-mono text-xs tracking-[0.25em] text-[var(--color-belt-gold)]">{project.tag}</p>
    <h3 class="mt-3 font-head text-3xl text-[var(--color-bone)] sm:text-4xl">{project.title}</h3>
    <p class="mt-4 text-sm leading-relaxed text-[var(--color-muted)] sm:text-base">
      {project.desc}
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
      {project.tags.map((tag) => <Tag>{tag}</Tag>)}
    </div>

    <a
      href={project.link}
      {...project.external ? { target: '_blank', rel: 'noreferrer' } : {}}
      class="mt-8 inline-flex items-center gap-2 font-cond text-sm font-semibold tracking-wide text-[var(--color-belt-gold)] uppercase transition-colors hover:text-[var(--color-bone)]"
    >
      {project.cta ?? 'Ver combate'}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
