---
import '../styles/global.css'
import Atmosphere from '../components/ui/Atmosphere.astro'

interface Props {
  title?: string
  description?: string
  image?: string
  overlays?: boolean
  pageClass?: string
}

const {
  title = 'Jorge Condado — Candidato a Programador Oficial de La Velada del Año',
  description = 'Más de 30.000 candidaturas. Una sola infraestructura. Portfolio-candidatura de Jorge Condado Carballo para ser el programador oficial de La Velada del Año.',
  image = '/images/1726564320490.jpeg',
  overlays = true,
  pageClass = '',
} = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={pageClass === 'netflix-page' ? '#141414' : '#07070a'} />
    <link rel="icon" type="image/jpeg" href="/images/LogoPersonal.jpg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jorge Condado Carballo" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Roboto:wght@300;400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={['relative antialiased', pageClass]}>
    {overlays && <Atmosphere />}

    <slot />

    <script>
      import { initSite } from '../scripts/site'

      initSite()
    </script>
  </body>
</html>
