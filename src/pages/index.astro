---
import Layout from '../layouts/Layout.astro'
import Intro from '../components/intro/Intro.astro'
import NetflixApp from '../netflix/NetflixApp'
---

<Layout
  title="La Velada del Código — El portfolio de Jorge Condado"
  description="Una película, un portfolio: la candidatura de Jorge Condado Carballo a programador oficial de La Velada del Año. Pulsa Watch Now para entrar en el portfolio completo."
  image="/images/Preview.webp"
  overlays={false}
  pageClass="netflix-page"
>
  <script is:inline>
    // La intro se reproduce en cada carga. Solo se omite si el usuario prefiere
    // movimiento reducido; en ese caso la página debe quedar visible al instante.
    ;(() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      if (reduced) document.documentElement.classList.add('intro-skip')
    })()
  </script>

  <noscript>
    <style is:inline>
      .intro {
        display: none !important;
      }
      .landing {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>

  <Intro />

  <div class="landing netflix-landing" data-landing>
    <div class="netflix-boot" aria-hidden="true">
      <div class="netflix-boot__mark logo-mark"></div>
      <p class="netflix-boot__label">La Velada del Código</p>
    </div>
    <NetflixApp client:only="react" />
  </div>
</Layout>
