---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/portfolio/Nav.astro'
import Hero from '../components/portfolio/Hero.astro'
import Applications from '../components/portfolio/Applications.astro'
import Lineup from '../components/portfolio/Lineup.astro'
import Corner from '../components/portfolio/Corner.astro'
import Palmares from '../components/portfolio/Palmares.astro'
import PressConference from '../components/portfolio/PressConference.astro'
import Contract from '../components/portfolio/Contract.astro'
import Footer from '../components/portfolio/Footer.astro'
---

<Layout
  title="Jorge Condado — Candidato a Programador Oficial de La Velada del Año"
  description="Portfolio-candidatura de Jorge Condado Carballo: más de 30.000 candidaturas, una sola infraestructura. Proyectos, trayectoria y perfil técnico para el puesto de programador oficial de La Velada del Año."
>
  <Nav />
  <main class="relative z-10">
    <Hero />
    <Applications />
    <Lineup />
    <Corner />
    <Palmares />
    <PressConference />
    <Contract />
  </main>
  <Footer />
</Layout>
