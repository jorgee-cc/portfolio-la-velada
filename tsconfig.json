{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "netflix-clone-react-typescript-main",
    "netflix-intro-animation-pure-css",
    "react-dailyui003landing-page"
  ],
  "compilerOptions": {
